# Optional containerized ROS1 bridge (use when Docker/Podman is preferred over
# the RoboStack conda ROS on the host). Build from the repository root:
#
#   docker build -f sil/docker/Dockerfile.bridge -t lead-sil-bridge .
#   docker run --rm --network host \
#       -e ROS_MASTER_URI=http://192.168.110.50:11311 \
#       -e ROS_IP=192.168.110.3 lead-sil-bridge
FROM ros:noetic-ros-base

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-zmq \
    && rm -rf /var/lib/apt/lists/*

COPY sil/ros_bridge/bridge_node.py /opt/lead_sil/bridge_node.py

ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["python3", "/opt/lead_sil/bridge_node.py"]
